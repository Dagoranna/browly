{
  "name": "browly-styles",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dagoranna/browly.git"
  },  
  "version": "1.0.2",
  "style": "dist/browly.css",
  "sass": "scss/style.scss",
  "exports": {
    ".": {
      "style": "./dist/browly.css",
      "default": "./dist/browly.css"
    },
    "./dist/*": "./dist/*",
    "./scss/*": "./scss/*",
    "./package.json": "./package.json"
  },  
  "files": [
    "scss",
    "dist/browly.css"
  ],  
  "description": "Lightweight UI framework for browser extensions (Vite + SCSS).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "sass": "^1.80.4",
    "vite": "^8.0.16"
  },
  "browserslist": [
    "last 5 Chrome versions",
    "last 5 Firefox versions",
    "last 5 Opera versions",
    "last 5 Edge versions"
  ]
}
